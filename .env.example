# ==============================================================================
# SECURE DOCUMENT PROVENANCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure environment-specific values before deployment.
# NEVER commit production secrets or real passwords to source control.

# Database Configuration (PostgreSQL with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/secure_docs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secure_docs

# Platform Security & JWT Token Signing
# Generate a cryptographically random secret with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-minimum-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage Path for Encrypted Document Ciphertexts
STORAGE_PATH=./storage/encrypted
MAX_DOCUMENT_SIZE_MB=25

# Document Encryption Key-Encryption-Key (KEK) - 256-bit AES Master Key (Base64)
# Generate a cryptographically secure key with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
DOCUMENT_KEK_BASE64=

# Recipient Private Key Protection Key (KEK) - 256-bit AES Master Key (Base64)
# Dedicated key hierarchy separating document DEK protection from recipient private key protection at rest
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
RECIPIENT_KEY_KEK_BASE64=

# System Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: Initial Root Administrator Setup (Alternatively use CLI interactive prompt)
# INITIAL_ADMIN_USERNAME=root_admin
# INITIAL_ADMIN_EMAIL=admin@platform.internal
# INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
