# Environment Configuration
PROJECT_NAME="Secure Document Provenance Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/secure_docs"

# Security & Tokens
SECRET_KEY="change-me-in-production-minimum-32-chars-long-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cryptographic Keys (256-bit AES-GCM keys, Base64-encoded, exactly 32 bytes when decoded)
# Document Key Encryption Key (KEK) for protecting DEKs
DOCUMENT_KEK_BASE64="dGVzdC1kZXZlbG9wbWVudC1tYXN0ZXIta2VrLTMyYnk="

# Recipient Key Encryption Key (KEK) for protecting recipient ML-KEM private keys
RECIPIENT_KEY_KEK_BASE64="cmVjaXBpZW50LXByb3RlY3Rpb24ta2VrLTMyYnl0ZXM="

# Provenance Key Encryption Key (KEK) for protecting ML-DSA signing keys
PROVENANCE_KEY_KEK_BASE64="cHJvdmVuYW5jZS1rZXktcHJvdGVjdGlvbi1rZWstMzI="

# Forensic Master Key for deriving recipient-session forensic fingerprints
FORENSIC_MASTER_KEY_BASE64="Zm9yZW5zaWMtbWFzdGVyLWtleS0zMi1ieXRlcy0wMDE="

# Dedicated Key Encryption Key for protecting user MFA TOTP credentials at rest
MFA_ENCRYPTION_KEY_BASE64="bWZhLWNyZWRlbnRpYWxzLXByb3RlY3Rpb24ta2V5MzI="

# Limits & Uploads
MAX_DOCUMENT_SIZE_MB=25

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
